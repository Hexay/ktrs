+/// A `BLOCK`/`LAMBDA_EXPRESSION` chameleon. With a cache, a recorded parse of the same non-trivia
+/// tokens is replayed when its trivia queries still hold (see `builder/replay.rs`); otherwise the
+/// parse runs and, if replayable, is recorded.
+fn parse_chameleon(leaf: &LazyLeaf<'_>, parse: fn(&mut Parser), sink: &mut TreeSink) {
+    let kind = leaf.kind;
+    let mut psi = leaf.relexed_builder();
+    if !sink.records() {
+        return run_into(psi, parse, Some(kind), sink);
+    }
+    if sink.replay(kind, &mut psi) {
+        let root = sink.len();
+        psi.build_tree_into(Some(kind), sink, &reparse_lazy);
+        if verify_replay() {
+            let mut fresh = TreeSink::new();
+            run_into(leaf.relexed_builder(), parse, Some(kind), &mut fresh);
+            assert!(sink.subtree(root) == *fresh.finish().tree, "replayed {kind:?} differs from its parse:\n{}", leaf.text);
+        }
+        return;
+    }
+    psi.log = Some(QueryLog::default());
+    let mut kt_parsing = Parser::create_for_top_level(SemanticWhitespaceAwarePsiBuilder::new(psi));
+    parse(&mut kt_parsing);
+    let psi = &mut kt_parsing.my_builder.psi;
+    let log = psi.log.take().expect("set above");
+    if let Some(record) = psi.replay_record(kind, &log) {
+        sink.insert_replay(record);
+    }
+    psi.build_tree_into(Some(kind), sink, &reparse_lazy);
+}
+
+/// `KTRS_VERIFY_REPLAY=1`: check every replayed chameleon against a real parse (for tests).
+fn verify_replay() -> bool {
+    static VERIFY: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *VERIFY.get_or_init(|| std::env::var_os("KTRS_VERIFY_REPLAY").is_some_and(|v| v == "1"))
+}
