diff --git a/crates/ktrs-parser/src/builder/replay.rs b/crates/ktrs-parser/src/builder/replay.rs
new file mode 100644
index 0000000..5c99e5c
--- /dev/null
+++ b/crates/ktrs-parser/src/builder/replay.rs
@@ -0,0 +1,291 @@
+//! Replaying a chameleon's parse on whitespace-changed text (see research/09-replay-reparse.md).
+//!
+//! A parse is a function of the non-trivia token sequence plus the answers to the few queries that
+//! look at trivia: newline-before-token and raw neighbour lookups. While a cached parse runs, the
+//! builder logs those queries; the finished production is stored with lexemes as token ordinals
+//! ("the gap before non-trivia token k", which `balance_white_spaces` treats alike whatever raw
+//! index in the gap was recorded). A later chameleon with the same non-trivia tokens whose logged
+//! queries answer the same gets that production back and only runs the tree phase. Anything
+//! outside that model (an anchor inside trivia, `raw_token_index`) makes the parse unrecordable.
+
+use ktrs_syntax::SyntaxKind;
+
+use super::production::MarkerData;
+use super::psi_builder::PsiBuilder;
+
+/// Trivia-observing queries of one parse, by raw lexeme index.
+#[derive(Default)]
+pub(crate) struct QueryLog {
+    queries: Vec<Query>,
+    unrecordable: bool,
+}
+
+#[derive(Clone, Copy)]
+enum Query {
+    /// `newline_before_current_token` with newlines enabled, not at EOF.
+    Newline { anchor: u32, result: bool },
+    /// `raw_lookup(steps)`.
+    Raw { anchor: u32, steps: i32 },
+    /// `raw_is(steps, kind)`.
+    RawIs { anchor: u32, steps: i32, kind: SyntaxKind },
+    /// `raw_is_trivia(steps)`.
+    RawTrivia { anchor: u32, steps: i32 },
+}
+
+impl QueryLog {
+    pub(crate) fn newline(&mut self, anchor: usize, result: bool) {
+        self.queries.push(Query::Newline { anchor: anchor as u32, result });
+    }
+
+    pub(crate) fn raw(&mut self, anchor: usize, steps: i32) {
+        self.queries.push(Query::Raw { anchor: anchor as u32, steps });
+    }
+
+    pub(crate) fn raw_is(&mut self, anchor: usize, steps: i32, kind: SyntaxKind) {
+        self.queries.push(Query::RawIs { anchor: anchor as u32, steps, kind });
+    }
+
+    pub(crate) fn raw_is_trivia(&mut self, anchor: usize, steps: i32) {
+        self.queries.push(Query::RawTrivia { anchor: anchor as u32, steps });
+    }
+
+    pub(crate) fn make_unrecordable(&mut self) {
+        self.unrecordable = true;
+    }
+}
+
+/// What a raw lookup saw: trivia and absence by kind, a real token by ordinal (its kind then
+/// follows from the parse itself, remaps included).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Seen {
+    Nothing,
+    Trivia(SyntaxKind),
+    Token(u32),
+}
+
+#[derive(Clone, Copy)]
+enum Check {
+    Newline { k: u32, result: bool },
+    Raw { k: u32, steps: i32, seen: Seen },
+    RawIs { k: u32, steps: i32, kind: SyntaxKind, result: bool },
+    RawTrivia { k: u32, steps: i32, result: bool },
+}
+
+/// A recorded chameleon parse, lexemes as token ordinals.
+pub struct ReplayRecord {
+    pub(super) kind: SyntaxKind,
+    /// The lexer's kinds and the texts of the non-trivia tokens.
+    token_kinds: Vec<SyntaxKind>,
+    token_text: String,
+    token_ends: Vec<u32>,
+    /// Kinds after the parse's remaps (soft keywords etc.), which become leaf kinds.
+    final_kinds: Vec<SyntaxKind>,
+    markers: Vec<MarkerData>,
+    list: Vec<i32>,
+    checks: Vec<Check>,
+}
+
+impl ReplayRecord {
+    pub(super) fn signature(&self) -> u64 {
+        let mut hasher = Signature::new(self.kind);
+        let mut start = 0;
+        for (&kind, &end) in self.token_kinds.iter().zip(&self.token_ends) {
+            hasher.add(kind, &self.token_text[start..end as usize]);
+            start = end as usize;
+        }
+        hasher.finish()
+    }
+}
+
+/// The non-trivia tokens of a builder: raw positions, and ordinals by raw index.
+struct Tokens {
+    pos: Vec<u32>,
+    /// `ord[i]` = number of non-trivia lexemes before raw index `i` (`lexeme_count + 1` entries).
+    ord: Vec<u32>,
+}
+
+impl PsiBuilder {
+    fn tokens(&self) -> Tokens {
+        let mut pos = Vec::new();
+        let mut ord = Vec::with_capacity(self.lexeme_count() + 1);
+        for (i, &kind) in self.orig_types.iter().enumerate() {
+            ord.push(pos.len() as u32);
+            if !kind.is_trivia() {
+                pos.push(i as u32);
+            }
+        }
+        ord.push(pos.len() as u32);
+        Tokens { pos, ord }
+    }
+
+    /// Hash of the chameleon `kind` over this builder's non-trivia (lexer kind, text) sequence.
+    pub(super) fn signature(&self, kind: SyntaxKind) -> u64 {
+        let mut hasher = Signature::new(kind);
+        for (i, &k) in self.orig_types.iter().enumerate() {
+            if !k.is_trivia() {
+                hasher.add(k, self.token_text(i));
+            }
+        }
+        hasher.finish()
+    }
+
+    /// The lexer's kind at raw `anchor + steps` (remaps aside: only compared with kinds they don't touch).
+    fn raw_kind(&self, anchor: usize, steps: i32) -> Option<SyntaxKind> {
+        let at = anchor as i64 + steps as i64;
+        (at >= 0 && (at as usize) < self.lexeme_count()).then(|| self.orig_types[at as usize])
+    }
+
+    fn seen(&self, tokens: &Tokens, anchor: usize, steps: i32) -> Seen {
+        match self.raw_kind(anchor, steps) {
+            None => Seen::Nothing,
+            Some(kind) if kind.is_trivia() => Seen::Trivia(kind),
+            Some(_) => Seen::Token(tokens.ord[(anchor as i64 + steps as i64) as usize]),
+        }
+    }
+
+    /// The finished parse of chameleon `kind` as a record, if its log allows it and it has no
+    /// errors (a record never has to reproduce error messages). Call before building the tree.
+    pub(crate) fn replay_record(&self, kind: SyntaxKind, log: &QueryLog) -> Option<ReplayRecord> {
+        if log.unrecordable || self.production.has_live_errors() || self.lexeme_count() == 0 {
+            return None;
+        }
+        // The root marker sits at raw 0 (it skips no trivia): only an ordinal if that's a token.
+        if self.orig_types[0].is_trivia() {
+            return None;
+        }
+        let tokens = self.tokens();
+        let count = self.lexeme_count();
+        let is_anchor = |i: usize| i == count || !self.orig_types[i].is_trivia();
+        let mut checks = Vec::with_capacity(log.queries.len());
+        for &query in &log.queries {
+            let (anchor, check) = match query {
+                Query::Newline { anchor, result } => (anchor, Check::Newline { k: tokens.ord[anchor as usize], result }),
+                Query::Raw { anchor, steps } => {
+                    let seen = self.seen(&tokens, anchor as usize, steps);
+                    (anchor, Check::Raw { k: tokens.ord[anchor as usize], steps, seen })
+                }
+                Query::RawIs { anchor, steps, kind } => {
+                    let result = self.raw_kind(anchor as usize, steps) == Some(kind);
+                    (anchor, Check::RawIs { k: tokens.ord[anchor as usize], steps, kind, result })
+                }
+                Query::RawTrivia { anchor, steps } => {
+                    let result = self.raw_kind(anchor as usize, steps).is_some_and(SyntaxKind::is_trivia);
+                    (anchor, Check::RawTrivia { k: tokens.ord[anchor as usize], steps, result })
+                }
+            };
+            if !is_anchor(anchor as usize) {
+                return None;
+            }
+            checks.push(check);
+        }
+        let (markers, list) = self.production.snapshot(|lexeme| tokens.ord[lexeme as usize] as i32);
+        let mut token_text = String::new();
+        let mut token_ends = Vec::with_capacity(tokens.pos.len());
+        for &p in &tokens.pos {
+            token_text.push_str(self.token_text(p as usize));
+            token_ends.push(token_text.len() as u32);
+        }
+        Some(ReplayRecord {
+            kind,
+            token_kinds: tokens.pos.iter().map(|&p| self.orig_types[p as usize]).collect(),
+            token_text,
+            token_ends,
+            final_kinds: tokens.pos.iter().map(|&p| self.lex_types[p as usize]).collect(),
+            markers,
+            list,
+            checks,
+        })
+    }
+
+    /// Installs the first of `records` whose parse applies to this fresh builder's lexemes (same
+    /// non-trivia tokens, every logged query answering the same); `false` leaves it untouched.
+    pub(crate) fn try_replay(&mut self, kind: SyntaxKind, records: &[ReplayRecord]) -> bool {
+        debug_assert!(self.production.is_empty());
+        // The root marker's raw 0 must be token 0 here too.
+        if records.is_empty() || self.orig_types.first().is_none_or(|k| k.is_trivia()) {
+            return false;
+        }
+        let tokens = self.tokens();
+        records.iter().any(|record| record.kind == kind && self.apply(&tokens, record))
+    }
+
+    fn apply(&mut self, tokens: &Tokens, record: &ReplayRecord) -> bool {
+        if tokens.pos.len() != record.token_kinds.len() || !self.same_tokens(tokens, record) {
+            return false;
+        }
+        let count = self.lexeme_count();
+        let raw_of = |k: u32| tokens.pos.get(k as usize).map_or(count, |&p| p as usize);
+        let holds = |check: &Check| match *check {
+            Check::Newline { k, result } => self.newline_before(raw_of(k)) == result,
+            Check::Raw { k, steps, seen } => self.seen(tokens, raw_of(k), steps) == seen,
+            Check::RawIs { k, steps, kind, result } => (self.raw_kind(raw_of(k), steps) == Some(kind)) == result,
+            Check::RawTrivia { k, steps, result } => {
+                self.raw_kind(raw_of(k), steps).is_some_and(SyntaxKind::is_trivia) == result
+            }
+        };
+        if !record.checks.iter().all(holds) {
+            return false;
+        }
+        for (&p, &kind) in tokens.pos.iter().zip(&record.final_kinds) {
+            self.lex_types[p as usize] = kind;
+        }
+        self.production.restore(&record.markers, &record.list, |k| raw_of(k as u32) as i32);
+        true
+    }
+
+    fn same_tokens(&self, tokens: &Tokens, record: &ReplayRecord) -> bool {
+        let mut start = 0;
+        tokens.pos.iter().zip(&record.token_kinds).zip(&record.token_ends).all(|((&p, &kind), &end)| {
+            let same = self.orig_types[p as usize] == kind
+                && self.token_text(p as usize) == &record.token_text[start..end as usize];
+            start = end as usize;
+            same
+        })
+    }
+
+    /// `newline_before_current_token`'s scan with the cursor at raw `at` (not EOF): back over
+    /// comments, true at a whitespace with a line break, false at anything else.
+    pub(crate) fn newline_before(&self, at: usize) -> bool {
+        for i in (0..at).rev() {
+            match self.lex_types[i] {
+                SyntaxKind::BLOCK_COMMENT | SyntaxKind::DOC_COMMENT | SyntaxKind::EOL_COMMENT | SyntaxKind::SHEBANG_COMMENT => {}
+                SyntaxKind::WHITE_SPACE => {
+                    let (start, end) = (self.lex_starts[i] as usize, self.lex_starts[i + 1] as usize);
+                    if self.text.as_bytes()[start..end].contains(&b'\n') {
+                        return true;
+                    }
+                }
+                _ => return false,
+            }
+        }
+        false
+    }
+}
+
+/// FxHash-style mix over the (kind, text) pairs.
+struct Signature(u64);
+
+impl Signature {
+    fn new(kind: SyntaxKind) -> Signature {
+        Signature(kind as u64)
+    }
+
+    fn mix(&mut self, word: u64) {
+        self.0 = (self.0.rotate_left(5) ^ word).wrapping_mul(0x517c_c1b7_2722_0a95);
+    }
+
+    fn add(&mut self, kind: SyntaxKind, text: &str) {
+        self.mix(kind as u64 | (text.len() as u64) << 16);
+        let (words, rest) = text.as_bytes().as_chunks::<8>();
+        for &word in words {
+            self.mix(u64::from_le_bytes(word));
+        }
+        let mut tail = [0u8; 8];
+        tail[..rest.len()].copy_from_slice(rest);
+        self.mix(u64::from_le_bytes(tail));
+    }
+
+    fn finish(&self) -> u64 {
+        self.0 ^ self.0 >> 29
+    }
+}
