rules=standard:blank-line-between-when-conditions
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=BlankLineBetweenWhenConditionsTest.Given when statement with multiline when-condition.Given linebreaks have to be added after when-condition.Given a when-condition preceded by a comment and the when-condition needs to be preceded by blank line then add this line before the comment
