rules=standard:call-expression-wrapping,standard:max-line-length
ec.max_line_length=30
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=CallExpressionWrappingRuleTest.Given a single line call expression, and lambda argument with parameter list, and the arrow of the lambda expression does not fits on the line then wrap after opening brace of lambda expression
