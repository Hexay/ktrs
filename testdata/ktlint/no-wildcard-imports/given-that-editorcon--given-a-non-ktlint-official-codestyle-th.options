rules=standard:no-wildcard-imports
ec.ktlint_code_style=intellij_idea
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=NoWildcardImportsRuleTest.Given that editorconfig property ij_kotlin_packages_to_use_import_on_demand is not set.Given a non-ktlint_official codestyle then the default wildcard imports allowed in other code styles are no longer allowed
