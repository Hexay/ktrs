rules=standard:argument-list-wrapping,standard:max-line-length
ec.max_line_length=33
ec.ktlint_argument_list_wrapping_ignore_when_parameter_count_greater_or_equal_than=8
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ArgumentListWrappingRuleTest.Given a function call with too many (eg more than 8) arguments.Given that arguments are on a single line but exceeding max line length
