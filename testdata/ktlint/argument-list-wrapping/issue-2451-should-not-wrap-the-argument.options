rules=standard:argument-list-wrapping,standard:max-line-length,standard:call-expression-wrapping,standard:chain-method-continuation,standard:indent,standard:multiline-expression-wrapping
ec.max_line_length=60
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ArgumentListWrappingRuleTest.Issue 2451 - Should not wrap the argument list when wrapping AST Nodes before the argument list prevent exceeding the max line length
