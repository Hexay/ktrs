rules=standard:argument-list-wrapping,standard:max-line-length,standard:function-signature,standard:indent
ec.max_line_length=35
ec.ktlint_function_signature_body_expression_wrapping=default
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
