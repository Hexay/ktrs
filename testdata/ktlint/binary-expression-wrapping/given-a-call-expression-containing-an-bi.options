rules=standard:binary-expression-wrapping,standard:max-line-length,standard:argument-list-wrapping,standard:wrapping
ec.max_line_length=34
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=BinaryExpressionWrappingRuleTest.Given a call expression containing an binary expression value argument, followed by a lambda on the same line, then wrap the lambda
