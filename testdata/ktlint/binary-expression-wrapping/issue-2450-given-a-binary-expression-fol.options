rules=standard:binary-expression-wrapping,standard:max-line-length,standard:max-line-length
ec.max_line_length=61
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=BinaryExpressionWrappingRuleTest.Issue 2450 - Given a binary expression followed by an EOL comment that causes the max line length to be exceeded, then only report a violation via max-line-length rule
