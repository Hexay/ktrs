rules=standard:binary-expression-wrapping,standard:max-line-length,standard:argument-list-wrapping,standard:indent,standard:wrapping
ec.max_line_length=31
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=BinaryExpressionWrappingRuleTest.Given a value argument containing a binary expression which causes the line to exceeds the maximum line length
