rules=standard:max-line-length
ec.max_line_length=37
ec.ktlint_ignore_back_ticked_identifier=true
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=MaxLineLengthRuleTest.Given a string between backticks.Given some text wrapped between backticks which is ignored but still the line length is exceeded with remainder of text then do return a lint error
