rules=standard:multiline-expression-wrapping,standard:indent,standard:function-signature
ec.ktlint_code_style=ktlint_official
ec.ktlint_function_signature_body_expression_wrapping=default
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=MultilineExpressionWrappingRuleTest.Given a function with a multiline body expression, and the function signature body expression wrapping is set to 'default' (eg keep first line of expression on same line)
