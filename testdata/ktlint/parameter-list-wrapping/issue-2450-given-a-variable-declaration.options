rules=standard:parameter-list-wrapping,standard:max-line-length,standard:indent,standard:max-line-length
ec.max_line_length=60
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ParameterListWrappingRuleTest.Issue 2450 - Given a variable declaration for a function type followed by an EOL comment that causes the max line length to be exceeded, then only report a violation via max-line-length rule
