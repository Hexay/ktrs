rules=standard:parameter-list-wrapping,standard:max-line-length,standard:indent
ec.ktlint_code_style=ktlint_official
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ParameterListWrappingRuleTest.Given a function literal having a multiline parameter list and the first parameter starts on same line as LBRACE.Given ktlint_official code style then reformat
