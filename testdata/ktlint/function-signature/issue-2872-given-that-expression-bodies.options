rules=standard:function-signature,standard:max-line-length,standard:indent
ec.max_line_length=34
ec.ktlint_function_signature_body_expression_wrapping=always
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FunctionSignatureRuleTest.Issue 2872 - Given that expression bodies have to be wrapped always, a multiline function signature without explicit return type and start of body expression on same line as last line of function signature then do reformat
