rules=standard:function-signature,standard:max-line-length,standard:function-start-of-body-spacing
ec.max_line_length=41
ec.ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=4
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FunctionSignatureRuleTest.Given a single line function signature which is equal to the max line length but missing a space before the opening brace of the body block, and the function is followed by a body block, then do no change the signature
