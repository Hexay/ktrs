rules=standard:function-signature,standard:max-line-length
ec.max_line_length=35
ec.ktlint_function_signature_body_expression_wrapping=default
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FunctionSignatureRuleTest.Issue 2592 - Given a function signature with an expression body that is multiline raw string literal then do not join the first leaf with the function signature
