rules=standard:function-signature,standard:max-line-length,standard:indent
ec.max_line_length=34
ec.ktlint_function_signature_body_expression_wrapping=default
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FunctionSignatureRuleTest.Given a multiline function signature without explicit return type and start of body expression on same line as last line of function signature then do not reformat[1]
