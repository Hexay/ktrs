rules=standard:function-signature,standard:max-line-length
ec.max_line_length=38
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FunctionSignatureRuleTest.Issue 3018 - Given a function signature with a context parameter.Issue 2800 - Given context parameter on a separate line, followed by a comment on separate line then ignore the context parameter and comment before rewriting the signature
