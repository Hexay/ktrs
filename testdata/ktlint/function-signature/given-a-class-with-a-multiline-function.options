rules=standard:function-signature,standard:max-line-length
ec.max_line_length=46
ec.ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FunctionSignatureRuleTest.Given a class with a multiline function signature which actually fits on a single line but for which the expression body does not fit at that same line then reformat the signature and wrap the body expression to the next line
