rules=standard:function-signature,standard:max-line-length
ec.ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=2
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FunctionSignatureRuleTest.Given a single line function signature having too many parameters then do reformat as multiline signature.Given a single line function signature and max line length not set but having too many parameters then do reformat as multiline signature
