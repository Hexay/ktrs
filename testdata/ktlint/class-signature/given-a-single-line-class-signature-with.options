rules=standard:class-signature,standard:max-line-length
ec.max_line_length=33
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=4
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a single line class signature, without class body, which is greater then the max line length then reformat to a multiline signature
