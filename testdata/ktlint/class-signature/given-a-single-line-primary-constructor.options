rules=standard:class-signature,standard:max-line-length,standard:indent
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=1
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a single line primary constructor which needs to be wrapped followed by a super type on the next line then merge supertype with line containing the closing parenthesis of the constructor
