rules=standard:class-signature,standard:max-line-length
ec.ktlint_code_style=ktlint_official
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a custom setting for the minimum number of parameters which enforces a multiline signature.Given the ktlint_official code style then avoid wrapping of parameters by overriding property ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than
