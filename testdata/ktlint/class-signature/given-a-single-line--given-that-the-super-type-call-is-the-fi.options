rules=standard:class-signature,standard:max-line-length
ec.max_line_length=60
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a single line class signature extending another class and some interfaces and fitting on a single line.Given that the super type call is the first super type
