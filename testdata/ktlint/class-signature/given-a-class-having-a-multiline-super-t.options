rules=standard:class-signature,standard:max-line-length,standard:indent
ec.max_line_length=40
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a class having a multiline super type list
