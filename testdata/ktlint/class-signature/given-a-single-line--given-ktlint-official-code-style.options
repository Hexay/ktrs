rules=standard:class-signature,standard:max-line-length
ec.ktlint_code_style=ktlint_official
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=2147483647
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a single line class signature with an annotated parameter.Given ktlint_official code style
