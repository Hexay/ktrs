rules=standard:class-signature,standard:max-line-length
ec.max_line_length=35
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a class with a body.Given a single line class signature which is smaller than or equal to the max line length, and the class is followed by a body block, then do not change the signature
