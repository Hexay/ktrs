rules=standard:class-signature,standard:max-line-length
ec.max_line_length=33
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=3
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a custom setting for the minimum number of parameters which enforces a multiline signature.Given a single line class signature which is smaller than or equal to the max line length but having too many parameters then do reformat as multiline signature
