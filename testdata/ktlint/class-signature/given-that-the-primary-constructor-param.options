rules=standard:class-signature,standard:max-line-length,standard:indent
ec.max_line_length=53
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=3
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given that the primary constructor parameters have to be wrapped and that the class has a multiline super type call entry then keep start of body on same line as end of super type call entry
