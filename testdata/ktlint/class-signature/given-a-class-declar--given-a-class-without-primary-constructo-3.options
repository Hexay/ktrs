rules=standard:class-signature,standard:max-line-length,standard:indent
ec.ktlint_code_style=intellij_idea
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a class declaration.Given a class without primary constructor, a multiline super type call entry starting on the same line as the class keyword and at least one other super type entry
