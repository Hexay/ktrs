rules=standard:class-signature,standard:max-line-length,standard:no-multi-spaces,standard:spacing-around-angle-brackets,standard:paren-spacing,standard:comma-spacing,standard:colon-spacing
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.CleanUpByRelatedRules.Given a class signature contains redundant spaces then ensure that those are removed before running the class signature rule
