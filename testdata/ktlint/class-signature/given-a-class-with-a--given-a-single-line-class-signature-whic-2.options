rules=standard:class-signature,standard:max-line-length,standard:function-start-of-body-spacing
ec.max_line_length=34
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.Given a class with a body.Given a single line class signature which is equal to the max line length but missing a space before the opening brace of the body block then reformat to a multiline signature
