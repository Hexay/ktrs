rules=standard:class-signature,standard:max-line-length,standard:type-parameter-list-spacing,standard:function-start-of-body-spacing,standard:function-type-reference-spacing,standard:colon-spacing,standard:comma-spacing,standard:op-spacing
ec.ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than=unset
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ClassSignatureRuleTest.CleanUpByRelatedRules.Given a class signature missing required spaces then ensure that those are added before running the class signature rule
