rules=standard:filename
path=/project/nonPascalCaseName.kt
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=FilenameRuleTest.Given a file containing a single top level class (non-private) and another top level declaration (non-private, not extending that class) then the file should conform to PascalCase notation but does not need to be named after that class[5]
