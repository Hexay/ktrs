rules=standard:trailing-comma-on-declaration-site,standard:indent
ec.ij_kotlin_allow_trailing_comma=true
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=TrailingCommaOnDeclarationSiteRuleTest.Issue 1519 - Given a when entry which is not a simple value but a dot qualified expression and that the trailing comma is required on declaration site then add it when missing
