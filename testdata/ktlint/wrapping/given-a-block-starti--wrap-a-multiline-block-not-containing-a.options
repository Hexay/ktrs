rules=standard:wrapping,standard:max-line-length
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=WrappingRuleTest.Given a block starting and ending on the same line.Wrap a multiline block not containing a newline between the last statement in the block and the RBRACE even in case the line containing the end of the block does not exceed the max-line-length
