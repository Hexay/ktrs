rules=standard:chain-method-continuation,standard:max-line-length,standard:argument-list-wrapping,standard:function-literal,standard:multiline-expression-wrapping,standard:indent,standard:max-line-length
ec.max_line_length=30
ec.ktlint_experimental=enabled
ec.ktlint_standard=enabled
test=ChainMethodContinuationRuleTest.Given a chained expression as function argument.Given the argument-list-wrapping, function-literal, multiline-expression and indent rules are enabled
