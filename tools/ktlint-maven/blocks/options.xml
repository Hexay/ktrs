        <configuration>
          <verbose>true</verbose>
          <failOnViolation>false</failOnViolation>
          <reporterColor>true</reporterColor>
          <reporterColorName>RED</reporterColorName>
          <testSourcesExcludes>
            <testSourcesExclude>**/FailTest.kt</testSourcesExclude>
          </testSourcesExcludes>
          <reporters>
            <reporter>
              <name>maven</name>
              <properties>
                <property><name>group_by_file</name><value>true</value></property>
                <property><name>pad</name><value>true</value></property>
              </properties>
            </reporter>
            <reporter>
              <name>plain</name>
              <output>${project.build.directory}/ktlint-color.txt</output>
            </reporter>
          </reporters>
        </configuration>
